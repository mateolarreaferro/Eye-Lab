[configuration]
entry_symbol = "satie_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
macos.debug.arm64 = "res://addons/satie/bin/libsatie_godot.dylib"
macos.release.arm64 = "res://addons/satie/bin/libsatie_godot.dylib"
android.debug.arm64 = "res://addons/satie/bin/libsatie_godot.android.arm64.so"
android.release.arm64 = "res://addons/satie/bin/libsatie_godot.android.arm64.so"
linux.debug.x86_64 = "res://addons/satie/bin/libsatie_godot.so"
linux.release.x86_64 = "res://addons/satie/bin/libsatie_godot.so"
windows.debug.x86_64 = "res://addons/satie/bin/satie_godot.dll"
windows.release.x86_64 = "res://addons/satie/bin/satie_godot.dll"
